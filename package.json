{
  "name": "@dsh-plugin/dsh-shell-select",
  "version": "1.0.1",
  "description": "DeepSeek Harness plugin: one model-facing `shell` tool whose shell is a user setting. Resolves and validates through the harness's own seams, and refuses to run when the selected shell cannot be confined.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    "./loader-check": "./loader-check.mjs",
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "loader-check.mjs",
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh_CN.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "shell",
    "bash",
    "zsh",
    "fish",
    "powershell",
    "pwsh",
    "cmd",
    "git-bash",
    "wsl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-shell-select.git"
  },
  "bugs": {
    "url": "https://github.com/dsh-plugins/dsh-shell-select/issues"
  },
  "homepage": "https://github.com/dsh-plugins/dsh-shell-select#readme",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-0"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('lib', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@dsh-plugin/dsh-loader": "^2.0.0-dev.41570953193"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.2.2-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-pwsh-local": "0.2.2-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.2-rc.2",
    "@deepseek-ai/dsh-shell-env": "0.2.2-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-util-values": "^0.2.2-rc.2",
    "@dsh-plugin/dsh-loader": "2.0.0-dev.41570953193",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
